<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bug Tracker</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.25/css/jquery.dataTables.min.css">
</head>
<body>

    <h2>Bug Tracker</h2>

    <form action="/addBug" method="POST">
        <label>Title:</label>
        <input type="text" name="title" required>
        
        <label>Description:</label>
        <input type="text" name="description" required>

        <label>Assignee:</label>
        <input type="text" name="assignee">

        <button type="submit">Add Bug</button>
    </form>

    <h3>Bug List</h3>
    <table id="bugTable" class="display">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Time</th>
                <th>Date</th>
                <th>Assignee</th>
                <th>Remaining Days</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <% bugs.forEach((bug) => { %>
                <% 
                    let assignedAt = new Date(bug.assignedAt);
                    let now = new Date();
                    let daysLeft = 3 - Math.floor((now - assignedAt) / (1000 * 60 * 60 * 24));
                    let rowColor = daysLeft <= 0 ? "style='background-color: red; color: white;'" : "";
                %>
                <tr>
                    <td><%= bug.title %></td>
                    <td><%= bug.description %></td>
                    <td><%= bug.time %></td>
                    <td><%= bug.date %></td>
                    <td><%= bug.assignee %></td>
                    <td <%= rowColor %>><%= daysLeft %> days left</td>
                    <td><%= bug.status %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <script>
        $(document).ready(function() {
            $('#bugTable').DataTable();
        });
    </script>

</body>
</html>